BUILDIUM_CLIENT_ID=
BUILDIUM_CLIENT_SECRET=

# Optional overrides
# BUILDIUM_ACCOUNTING_BASIS=Accrual
# BUILDIUM_OPERATING_ACCOUNT_NAME=(ops)
# BUILDIUM_SD_ACCOUNT_NAME=(trust),security deposit
# BUILDIUM_EXCLUDE_ACCOUNT_NAME=dnu

# --- MCP server transport & auth -------------------------------------------
# Leave MCP_TRANSPORT unset (or "stdio") for local Claude Desktop / Claude
# Code usage via .mcp.json -- no auth applies there, it's a local subprocess.
#
# Set to "streamable-http" to run as a network-reachable server. See
# DEPLOY.md. This REQUIRES MCP_API_KEYS below (or explicit MCP_DISABLE_AUTH).
# MCP_TRANSPORT=streamable-http
# MCP_HOST=0.0.0.0
# MCP_PORT=8000

# One or more "name:token" pairs, comma-separated -- one per authorized user
# or integration. Generate each token with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Clients send theirs as an `x-api-key` header (not `Authorization` -- see
# DEPLOY.md / scripts/auth_tokens.py for why).
# MCP_API_KEYS=alice:REPLACE_WITH_A_LONG_RANDOM_TOKEN,bot-cowork:REPLACE_WITH_ANOTHER_TOKEN

# Never set this in production -- disables auth entirely for local testing.
# MCP_DISABLE_AUTH=true

# Optional: lock the HTTP transport to a known reverse-proxy hostname/origin.
# MCP_ALLOWED_HOSTS=buildium-mcp.example.com
# MCP_ALLOWED_ORIGINS=https://buildium-mcp.example.com

# LOG_LEVEL=INFO

# --- Google sign-in for the Claude connector (see DEPLOY.md) ----------------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MCP_OAUTH_SECRET=   # 40+ random characters
# MCP_PUBLIC_URL=https://buildium-mcp.onrender.com
